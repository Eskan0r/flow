{
  "name": "flow-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/hooks.mjs tests/validate.mjs && node --experimental-strip-types --no-warnings --import ./tests/hooks.mjs tests/engine.mjs && node --experimental-strip-types --no-warnings --import ./tests/hooks.mjs tests/packs.mjs",
    "test:unit": "ng test",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "test:e2e": "start-server-and-test start http://localhost:4200 cypress:run"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@spartan-ng/cli": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "cypress": "^16.1.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
